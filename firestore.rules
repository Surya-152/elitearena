rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    function isAuth()     { return request.auth != null; }
    function isOwner(uid) { return isAuth() && request.auth.uid == uid; }
    function isAdmin() {
      return isAuth() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role','user') == 'admin';
    }
    function isNotBanned() {
      return isAuth() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('banned', false) == false;
    }
    function validUsername(u) { return u.size() >= 3 && u.size() <= 20 && u.matches('[a-zA-Z0-9_]+'); }
    function validAmount(a)   { return a is int && a > 0; }

    // ── Users ─────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      allow create: if isOwner(userId)
        && request.resource.data.keys().hasAll(['uid','email','username','elite_coins_balance','matches_played','total_winnings','role','createdAt'])
        && request.resource.data.uid          == request.auth.uid
        && request.resource.data.role         == 'user'   // cannot self-assign admin
        && request.resource.data.elite_coins_balance == 0
        && request.resource.data.matches_played      == 0
        && request.resource.data.total_winnings      == 0
        && validUsername(request.resource.data.username);

      // Users can ONLY change username + updatedAt
      allow update: if isOwner(userId) && isNotBanned()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['username','updatedAt'])
        && validUsername(request.resource.data.username)
        // Cannot change role, balance, etc.
        && request.resource.data.role                == resource.data.role
        && request.resource.data.elite_coins_balance == resource.data.elite_coins_balance;

      allow update: if isAdmin(); // Admin can update any field
      allow delete: if false;     // Never delete users
    }

    // ── Tournaments ───────────────────────────────────────────────────────────
    match /tournaments/{tid} {
      allow read:                   if isAuth();
      allow create, update, delete: if isAdmin();

      match /registrations/{uid} {
        allow read:          if isAuth();
        allow create:        if isOwner(uid) && isNotBanned();
        allow update,delete: if isAdmin();
      }
    }

    // ── User registration fast-lookup ─────────────────────────────────────────
    match /user_registrations/{uid}/tournaments/{tid} {
      allow read:          if isOwner(uid) || isAdmin();
      allow create:        if isOwner(uid) && isNotBanned();
      allow update,delete: if isAdmin();
    }

    // ── Transactions (audit log) ──────────────────────────────────────────────
    match /transactions/{txId} {
      allow read:   if isAuth() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update,delete: if false;
    }

    // ── Ad Rewards ────────────────────────────────────────────────────────────
    match /ad_rewards/{id} {
      allow read:   if isAuth();
      allow create: if isAuth() && isNotBanned()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.amount == 1;  // Always 1 EC per ad
      allow update,delete: if false;
    }

    // ── Notifications ─────────────────────────────────────────────────────────
    match /notifications/{uid}/items/{id} {
      allow read:   if isOwner(uid);
      allow create: if isAdmin();
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isAdmin();
    }

    // ── Deposits ──────────────────────────────────────────────────────────────
    match /deposits/{id} {
      allow read:   if isAuth() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isAuth() && isNotBanned()
        && request.resource.data.uid       == request.auth.uid
        && request.resource.data.amount_inr >= 50
        && request.resource.data.status    == 'pending'
        && request.resource.data.ec_amount  is int
        && request.resource.data.ec_amount  > 0;
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ── Withdrawals ───────────────────────────────────────────────────────────
    match /withdrawals/{id} {
      allow read:   if isAuth() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isAuth() && isNotBanned()
        && request.resource.data.uid      == request.auth.uid
        && request.resource.data.status   == 'scheduled'
        && request.resource.data.ec_amount is int
        && request.resource.data.ec_amount >= 500;
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ── KYC Reviews ───────────────────────────────────────────────────────────
    match /kyc_reviews/{id} {
      allow read:   if isAdmin();
      allow create: if isAuth() && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ── Support Tickets ───────────────────────────────────────────────────────
    match /support_tickets/{id} {
      allow read:   if isAuth() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isAuth() && isNotBanned()
        && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if false;
    }
  
    // ── Referrals ─────────────────────────────────────────────────────────────
    match /referrals/{id} {
      allow read:   if isAuth() && (resource.data.referrerUid == request.auth.uid || isAdmin());
      allow create: if isAuth() && request.resource.data.newUserUid == request.auth.uid;
      allow update,delete: if false;
    }

    // ── Daily reward log ─────────────────────────────────────────────────────
    match /daily_rewards/{id} {
      allow read:          if isAuth() && resource.data.uid == request.auth.uid;
      allow create:        if isAuth() && request.resource.data.uid == request.auth.uid;
      allow update,delete: if false;
    }

    // ── Tournament Chat ───────────────────────────────────────────────────────
    match /tournament_chats/{tid}/messages/{msgId} {
      allow read:   if isAuth();
      allow create: if isAuth() && isNotBanned()
        && request.resource.data.uid      == request.auth.uid
        && request.resource.data.text.size() <= 200
        && request.resource.data.text.size() > 0;
      allow update,delete: if isAdmin();
    }

    // ── Teams ─────────────────────────────────────────────────────────────────
    match /teams/{teamId} {
      allow read:   if isAuth();
      allow create: if isAuth() && isNotBanned()
        && request.resource.data.captainUid == request.auth.uid;
      allow update: if isAuth() && isNotBanned()
        && (resource.data.captainUid == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // ── Blog Articles ─────────────────────────────────────────────────────────
    match /blog_articles/{articleId} {
      // Anyone can read published articles
      allow read: if resource.data.published == true || isAdmin();
      // Only admin can create, update, delete
      allow create, update, delete: if isAdmin();
    }

  }
}