# ============================================================
# EliteArena v7 — Environment Variables
# STEP 1: cp .env.example .env
# STEP 2: Fill ALL values below
# STEP 3: NEVER commit .env to git
# ============================================================

# ────────────────────────────────────────────────────────────
# FIREBASE CONFIGURATION
# Where to get: console.firebase.google.com
#   → Your Project → Settings (⚙️) → Your Apps → Web App </>
#   → SDK setup and configuration → Copy all 6 values
# ────────────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=AIzaSy_REPLACE_WITH_YOUR_KEY
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# ────────────────────────────────────────────────────────────
# ADMIN UID
# Where to get:
#   1. npm run dev → /register → account banao
#   2. Firebase Console → Authentication → Users
#   3. Apni email ke saamne UID copy karo (long string)
#   4. Firestore → users → [your-uid] → role: "admin" set karo
# ────────────────────────────────────────────────────────────
VITE_ADMIN_UID=REPLACE_WITH_YOUR_FIREBASE_UID

# ────────────────────────────────────────────────────────────
# UPI PAYMENT CONFIGURATION
# VITE_OWNER_UPI_ID: Aapka UPI ID jahan users paisa bhejenge
#   Example: yourname@paytm  OR  9876543210@ybl  OR  name@okicici
# VITE_OWNER_UPI_NAME: Display name on payment screen
# VITE_UPI_QR_URL: (Optional) QR code image URL
#   Steps: UPI app → Receive Money → Screenshot QR
#          → Cloudinary.com (free upload) → Direct image URL copy
# ────────────────────────────────────────────────────────────
VITE_OWNER_UPI_ID=yourname@paytm
VITE_OWNER_UPI_NAME=EliteArena
VITE_UPI_QR_URL=

# ────────────────────────────────────────────────────────────
# ELITECOINS RATE & LIMITS
# VITE_EC_PER_RUPEE: 1 means ₹1 = 1 EC (default)
#   Change to 2 for ₹1 = 2 EC (cheaper for users)
# ────────────────────────────────────────────────────────────
VITE_EC_PER_RUPEE=1
VITE_MIN_DEPOSIT=50
VITE_MAX_DEPOSIT=10000
VITE_MIN_WITHDRAWAL=500
VITE_MAX_WITHDRAWAL=50000
VITE_WITHDRAWAL_DELAY_MINUTES=10

# ────────────────────────────────────────────────────────────
# GOOGLE ADSENSE (fill AFTER AdSense account approved)
# Where to get: adsense.google.com
#   Step 1: Apply at adsense.google.com (approval 1-14 days)
#   Step 2: Approval ke baad: AdSense Console → Account Info → Publisher ID
#   Step 3: Ads → By Ad Unit → Create Display Ad → Slot ID copy
# ────────────────────────────────────────────────────────────
VITE_ADSENSE_PUBLISHER_ID=ca-pub-REPLACE_WITH_YOUR_PUBLISHER_ID
VITE_AD_SLOT_SIDEBAR=REPLACE_WITH_SIDEBAR_SLOT_ID
VITE_AD_SLOT_BANNER=REPLACE_WITH_BANNER_SLOT_ID
VITE_AD_SLOT_INFEED=REPLACE_WITH_INFEED_SLOT_ID

# ────────────────────────────────────────────────────────────
# SITE URL (for SEO canonical tags)
# After Vercel deploy: your actual URL yahan daalo
# Example: https://elitearena.vercel.app
# ────────────────────────────────────────────────────────────
VITE_SITE_URL=https://yourdomain.com

# ────────────────────────────────────────────────────────────
# LOCAL DEVELOPMENT (optional)
# Firebase Emulators ke liye: firebase emulators:start
# ────────────────────────────────────────────────────────────
VITE_USE_EMULATOR=false

# ────────────────────────────────────────────────────────────
# NEW FEATURES
# ────────────────────────────────────────────────────────────

# Withdrawal fee percentage (default 5%)
# User ₹1000 withdraw karta hai → platform ₹50 rakhta hai, user ko ₹950 milta hai
VITE_WITHDRAWAL_FEE_PERCENT=5

# ElitePass price in EC (default 99 EC = ₹99/month)
# Users ye EC wallet se spend karte hain premium membership ke liye
VITE_ELITE_PASS_PRICE_EC=99

# ────────────────────────────────────────────────────────────
# AD NETWORKS — Multi-network for maximum revenue
# ────────────────────────────────────────────────────────────

# 1. GOOGLE ADSENSE (Primary — best RPM after approval)
#    Apply at: adsense.google.com → Website → Get approved → Publisher ID
VITE_ADSENSE_PUBLISHER_ID=ca-pub-REPLACE_WITH_PUBLISHER_ID
VITE_AD_SLOT_SIDEBAR=REPLACE_SIDEBAR_SLOT_ID
VITE_AD_SLOT_BANNER=REPLACE_BANNER_SLOT_ID
VITE_AD_SLOT_INFEED=REPLACE_INFEED_SLOT_ID

# 2. MEDIA.NET (Yahoo/Bing ads — runs alongside AdSense, no conflict!)
#    Apply at: media.net → Publisher → Apply → Get Site ID (3-5 days)
#    Revenue: Usually 50-80% of AdSense RPM, but additive!
VITE_MEDIANET_SITE_ID=REPLACE_MEDIANET_SITE_ID
VITE_MEDIANET_SLOT_SIDEBAR=REPLACE_MEDIANET_SIDEBAR_SLOT
VITE_MEDIANET_SLOT_BANNER=REPLACE_MEDIANET_BANNER_SLOT

# 3. PROPELLERADS (Gaming-friendly, no approval needed!)
#    Register: propellerads.com → Publisher → Create Zone → Get IDs
#    Best for: Interstitials, push notifications, banner ads
VITE_PROPELLER_SITE_ID=REPLACE_PROPELLER_SITE_ID
VITE_PROPELLER_ZONE_ID=REPLACE_PROPELLER_ZONE_ID

# 4. AMAZON AFFILIATE (Shopping ads — gaming gear recommendations)
#    Register: affiliate-program.amazon.in → Get tracking tag
#    Already configured with default tag elitearena-21 (change to yours)
VITE_AMAZON_AFFILIATE_TAG=your-amazon-tag-21
VITE_AMAZON_AD_INSTANCE_ID=REPLACE_AMAZON_INSTANCE_ID

# ────────────────────────────────────────────────────────────
# AMBIENT SOUND (no config needed — Web Audio API)
# Users can toggle on/off via button in bottom-right corner
# ────────────────────────────────────────────────────────────
# No config required — works out of the box!

# Flipkart Affiliate
# Register: affiliate.flipkart.com → Get Tracking ID
VITE_FLIPKART_AFFILIATE_ID=REPLACE_FLIPKART_AFFILIATE_ID

# ── Social Media Links ───────────────────────────────────────
# Update these in src/components/common/Footer.jsx
# WHATSAPP_COMMUNITY=https://wa.me/yourwhatsappnumber
# INSTAGRAM=https://instagram.com/elitearena_esports
# YOUTUBE=https://youtube.com/@elitearena
# TELEGRAM=https://t.me/elitearena_official

# ────────────────────────────────────────────────────────────
# SOCIAL MEDIA LINKS (shown in footer — fill after creating accounts)
# Leave empty if you don't have the account yet
# ────────────────────────────────────────────────────────────
# WhatsApp Community link: wa.me se banao
# https://wa.me/ → Create a WhatsApp link
VITE_SOCIAL_WHATSAPP=https://wa.me/919876543210

# Instagram page
VITE_SOCIAL_INSTAGRAM=https://instagram.com/yourbrandname

# YouTube channel
VITE_SOCIAL_YOUTUBE=https://youtube.com/@yourchannel

# Telegram group/channel
VITE_SOCIAL_TELEGRAM=https://t.me/yourchannel

# Support email (shown in Privacy Policy and Terms)
VITE_SUPPORT_EMAIL=support@yourdomain.com
